        box-shadow: 0 2px 12px rgba(0,0,0,.06);
    ">
        <!-- Top accent bar -->
        <div style="
            height: 4px;
            background: linear-gradient(90deg, var(--cr-blue, #0077a8), var(--cr-blue-bar, #1a8ab5), var(--cr-teal, #1a9a8a));
        "></div>

        <!-- Padded content -->
        <div style="padding: 36px 32px 30px;">

            <!-- Lock icon -->
            <div style="
                width: 64px;
                height: 64px;
                margin: 0 auto 18px;
