            <div style="
                margin-top: 22px;
                padding: 12px 16px;
                background: var(--cr-blue-light, #e8f4f9);
                border-radius: var(--cr-radius, 6px);
                font-size: 13px;
                color: var(--cr-text-muted, #4a5a64);
                line-height: 1.5;
                text-align: left;
            ">
                <i class="fa fa-info-circle" style="color: var(--cr-blue, #0077a8); margin-right: 5px;"></i>
