    max-width: 620px;
    margin: 30px auto 20px;
    font-family: 'Open Sans', sans-serif;
    text-align: center;
">
    <!-- Card container -->
    <div style="
        background: #fff;
        border: 1px solid var(--cr-border, #dce3e8);
        border-radius: var(--cr-radius, 6px);
