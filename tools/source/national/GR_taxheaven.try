"84\u0391","title":"\u0394\u03b7\u03bc\u03bf\u03c3\u03b9\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03ce\u03bd \u03b4\u03b5\u03b4\u03bf\u03bc\u03ad\u03bd\u03c9\u03bd \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03b5\u03b9\u03c3\u03b1\u03b3\u03b3\u03b5\u03bb\u03b9\u03ba\u03ae \u03b1\u03c1\u03c7\u03ae","chapter":""},{"id":33466,"num":"85","title":"\u0399\u03c3\u03c7\u03cd\u03c2 \u03b4\u03b9\u03b5\u03b8\u03bd\u03ce\u03bd \u03ae \u03b4\u03b9\u03bc\u03b5\u03c1\u03ce\u03bd \u03b4\u03b9\u03b5\u03b8\u03bd\u03ce\u03bd \u03c3\u03c5\u03bc\u03c6\u03c9\u03bd\u03b9\u03ce\u03bd","chapter":""},{"id":33467,"num":"86","title":"","chapter":""},{"id":33468,"num":"87","title":"\u0388\u03bd\u03b1\u03c1\u03be\u03b7 \u03b9\u03c3\u03c7\u03cd\u03bf\u03c2","chapter":""}];

    // ── References ───────────────────────────────────────────
    var container   = document.getElementById('lawtArticlesContainer');
    var progressCur = document.getElementById('lawtProgressCurrent');
    var progressFill = document.getElementById('lawtProgressFill');

    // ── TOC View Toggle (list / grid) ─────────────────────────
    var tocListWrap = document.getElementById('lawtTocListWrap');
    var tocGridWrap = document.getElementById('lawtTocGridWrap');
    var tocListBtn  = document.getElementById('lawtTocListBtn');
    var tocGridBtn  = document.getElementById('lawtTocGridBtn');
    var tocViewMode = 'grid'; // 'list' | 'grid'

    function updateTocGridActive(artNum) {
        if (!artNum) return;
        var cells = document.querySelectorAll('.lawt-toc-grid-cell');
        for (var i = 0; i < cells.length; i++) {
            var isActive = cells[i].getAttribute('data-art-num') === artNum;
            cells[i].classList.toggle('active', isActive);
            if (isActive) {
                cells[i].scrollIntoView({ block: 'nearest' });
            }
        }
    }

    function filterTocGrid(query) {
        var q = (query || '').toLowerCase().trim();
        var cells = document.querySelectorAll('.lawt-toc-grid-cell');
        for (var i = 0; i < cells.length; i++) {
            var num = (cells[i].getAttribute('data-art-num') || '').toLowerCase();
            cells[i].classList.toggle('lawt-toc-grid-hidden', !!q && num.indexOf(q) === -1);
        }
    }

    function setTocView(mode) {
        tocViewMode = mode;
        // Clear search when switching
        var tocSearchEl = document.getElementById('lawtTocSearch');
        if (tocSearchEl) tocSearchEl.value = '';

        if (mode === 'grid') {
            if (tocListWrap) tocListWrap.style.display = 'none';
            if (tocGridWrap) tocGridWrap.style.display = '';
            if (tocListBtn) tocListBtn.classList.remove('active');
            if (tocGridBtn) tocGridBtn.classList.add('active');
            // Sync grid active state with current article
            var curNum = progressCur ? progressCur.textContent : null;
            if (curNum) updateTocGridActive(curNum);
            // Reset filter
            filterTocGrid('');
        } else {
            if (tocListWrap) tocListWrap.style.display = '';
            if (tocGridWrap) tocGridWrap.style.display = 'none';
            if (tocListBtn) tocListBtn.classList.add('active');
            if (tocGridBtn) tocGridBtn.classList.remove('active');
            // Reset list filter
            Lawt.filterLawToc('');
        }
    }

    if (tocListBtn) tocListBtn.addEventListener('click', function() { setTocView('list'); });
    if (tocGridBtn) tocGridBtn.addEventListener('click', function() { setTocView('grid'); });

    // ── TOC Grid: click handler ────────────
    // (uses Lawt.jumpToArticle which handles expand + scroll)
    document.addEventListener('click', function(e) {
        var cell = e.target.closest('.lawt-toc-grid-cell');
        if (!cell) return;
        e.preventDefault();
        Lawt.closeMobileToc();
        var artDisplay = cell.getAttribute('data-art-num');
        if (artDisplay) Lawt.jumpToArticle(artDisplay);
    });

    // ── TOC Search / Filter ──────────────────────────────────
    var tocSearch = document.getElementById('lawtTocSearch');
    if (tocSearch) {
        tocSearch.addEventListener('input', function() {
            if (tocViewMode === 'grid') {
                filterTocGrid(this.value);
            } else {
                Lawt.filterLawToc(this.value);
            }
        });
    }

    // ══════════════════════════════════════════════════════════════
    //  COLLAPSED ARTICLES — Expand / Collapse + Deep Links
    //  Chat 38: Replaces ScrollSpy, batch loading, old jumpToArticle
    //  Chat 39: Lazy counts (Phase 2 AJAX after expand)
    // ══════════════════════════════════════════════════════════════


    // ── Lazy Counts: Phase 2 — load cross-ref + history counts ──
    function loadLazyCounts( $card, articleId ) {
        $.getJSON( countsUrl + '/' + articleId ).done( function( data ) {
            if ( !data || !data.article ) return;

            // Article-level badges
            _setBadge( $card, 'art-news', data.article.news );
            _setBadge( $card, 'art-docs', data.article.docs );
            _setBadge( $card, 'art-history', data.article.history );

            // Article hint (in tools toggle button)
            if ( data.article.news > 0 || data.article.docs > 0 ) {
                $card.find( '[data-lazy-hint]' ).removeClass( 'lawt-lazy-hidden' );
            }

            // Imported groups (injected dynamically)
            var $container = $card.find( '[data-lazy-imported]' );
            if ( $container.length && data.article.imported ) {
                var canTools  = $container.data( 'can-tools' ) == 1;
                var artDisplay = $container.data( 'art-display' );
                var artId      = $container.data( 'art-id' );

                $.each( data.article.imported, function( fromRef, cnt ) {
                    var html;
                    if ( canTools ) {
                        html = '<a class="lawt-art-link-item" data-panel="docs"'
                             + ' data-context="Άρθρο ' + artDisplay + ' — Σχετικές από ν. ' + fromRef + '"'
                             + ' data-target="article-' + artId + '"'
                             + ' data-from-ref="' + fromRef + '">Σχετικές από νόμο ' + fromRef
                             + ' <span class="lawt-nos">' + cnt + '</span></a>';
                    } else {
                        html = '<a href="#" class="lawt-art-link-item lawt-access-gate">'
                             + 'Σχετικές από νόμο ' + fromRef
                             + ' <span class="lawt-nos">' + cnt + '</span></a>';
                    }
                    $container.before( html );
                });
            }

            // Paragraph-level badges
            if ( data.paragraphs ) {
                $.each( data.paragraphs, function( paraId, counts ) {
                    var $para = $card.find( '[data-para-id="' + paraId + '"]' );
                    if ( !$para.length ) return;
                    _setBadge( $para, 'para-news', counts.news );
                    _setBadge( $para, 'para-docs', counts.docs );
                });
            }
        }).fail( function() {
            // Silent fail — lazy counts are non-critical; article body still renders
        });
    }

    function _setBadge( $scope, type, count ) {
        if ( !count || count <= 0 ) return;
        $scope.find( '[data-lazy-count="' + type + '"]' )
              .text( count )
              .removeClass( 'lawt-lazy-hidden' );
        $scope.find( '[data-lazy-show="' + type + '"]' )
              .removeClass( 'lawt-lazy-hidden' );
    }


    // ── Core: expand or collapse a single article card ───────────
    //   bulkMode=true → suppresses access gate message (used by open-all)
    function expandArticle( cardEl, callback, bulkMode ) {
        var $card = $( cardEl );
        var articleId = $card.data( 'article-id' );
        var $body = $card.find( '.lawt-art-card-body' );

        // ── Toggle: already expanded → collapse ──
        if ( $card.hasClass( 'lawt-art-expanded' ) ) {
            $card.removeClass( 'lawt-art-expanded' );
            expandedCount--;
            updateToolbarCount();
            if ( callback ) callback();
            return;
        }

        // ── Paywall: no access → subscription gate ──
        if ( !hasFullAccess ) {
            if ( !bulkMode ) Lawt.showAccessMessage();
            return;
        }

        // ── Cached: already fetched → just show ──
        if ( $body.data( 'loaded' ) ) {
            $card.addClass( 'lawt-art-expanded' );
            expandedCount++;
            updateToolbarCount();
            if ( callback ) callback();
            return;
        }

        // ── AJAX fetch article body ──
        $card.addClass( 'lawt-art-expanded' );
        $body.html( '<div class="lawt-art-card-loading"><i class="fa fa-spinner fa-spin"></i> Φόρτωση…</div>' );

        $.get( expandUrl + '/' + articleId )
            .done( function( resp ) {
                $body.html( resp.html );
                $body.data( 'loaded', true );
                expandedCount++;
                updateToolbarCount();
                // Phase 2: lazy counts (background AJAX)
                loadLazyCounts( $card, articleId );
                if ( callback ) callback();
            })
            .fail( function( xhr ) {
                if ( xhr.status === 403 && !bulkMode ) {
                    Lawt.showAccessMessage();
                }
                $card.removeClass( 'lawt-art-expanded' );
                $body.html( '' );
                if ( callback ) callback();
            });
    }


    // ── Click handler: card headers ─────────────────────────────
    $( document ).on( 'click', '[data-expand-article]', function( e ) {
        e.preventDefault();
        var card = $( this ).closest( '.lawt-art-card' )[ 0 ];
        if ( card ) expandArticle( card );
    });


    // ── TOC clicks: expand + scroll ─────────────────────────────
    function bindTocClicks() {
        var tocLinks = document.querySelectorAll( '.lawt-toc-link[href^="#arthro"]' );
        tocLinks.forEach( function( link ) {
            if ( link._lawtBound ) return;
            link._lawtBound = true;

            link.addEventListener( 'click', function( e ) {
                e.preventDefault();

                // Close mobile drawer
                Lawt.closeMobileToc();

                var artDisplay = link.getAttribute( 'data-art-num' );
                if ( artDisplay ) {
                    Lawt.jumpToArticle( artDisplay );
                }
            });
        });
    }
    bindTocClicks();


    // ── Articles Toolbar — "Ανοίξτε τα όλα" ─────────────────
    var openAllBtn          = document.getElementById( 'lawtOpenAllBtn' );
    var stopBtn             = document.getElementById( 'lawtStopBtn' );
    var toolbar             = document.getElementById( 'lawtArticlesToolbar' );
    var toolbarLoaded       = document.getElementById( 'lawtToolbarLoaded' );
    var toolbarProgressBar  = document.getElementById( 'lawtToolbarProgressBar' );
    var toolbarProgressFill = document.getElementById( 'lawtToolbarProgressFill' );
    var _openAllStopped     = false;

    function updateToolbarCount() {
        if ( toolbarLoaded ) toolbarLoaded.textContent = expandedCount;
        if ( toolbarProgressFill ) {
            toolbarProgressFill.style.width =
                Math.round( ( expandedCount / totalArticles ) * 100 ) + '%';
        }
    }

    function hideToolbar() {
        if ( toolbar ) toolbar.style.display = 'none';
    }

    // Stop button
    if ( stopBtn ) {
        stopBtn.addEventListener( 'click', function() {
            _openAllStopped = true;
            if ( openAllBtn ) { openAllBtn.style.display = ''; openAllBtn.disabled = false; }
            if ( stopBtn ) stopBtn.style.display = 'none';
            if ( toolbarProgressBar ) toolbarProgressBar.style.display = 'none';
        });
    }

    // Open-all: sequential expand of each collapsed card
    if ( openAllBtn ) {
        openAllBtn.addEventListener( 'click', function() {
            _openAllStopped = false;

            var allCards = document.querySelectorAll( '.lawt-art-card:not(.lawt-art-expanded)' );
            var queue = Array.prototype.slice.call( allCards );
            var i = 0;

            if ( openAllBtn ) openAllBtn.style.display = 'none';
            if ( stopBtn ) stopBtn.style.display = '';
            if ( toolbarProgressBar ) toolbarProgressBar.style.display = '';

            function nextExpand() {
                if ( i >= queue.length || _openAllStopped ) {
                    // Done or cancelled
                    if ( openAllBtn ) openAllBtn.style.display = '';
                    if ( stopBtn ) stopBtn.style.display = 'none';
                    if ( toolbarProgressBar ) toolbarProgressBar.style.display = 'none';
                    if ( i >= queue.length ) hideToolbar();
                    return;
                }

                expandArticle( queue[ i ], function() {
                    i++;
                    updateToolbarCount();
                    setTimeout( nextExpand, 80 );
                }, true );
            }

            nextExpand();
        });
    }


    // ══════════════════════════════════════════════════════════════
    //  JUMP TO ARTICLE — simplified for collapsed architecture
    // ══════════════════════════════════════════════════════════════

    /**
     * Jump to article by number_display.
     * All cards exist in DOM (collapsed). Just expand + scroll.
     */
    Lawt.jumpToArticle = function( artDisplay, callback ) {
        var targetId = 'arthro-' + encodeURIComponent( artDisplay ).replace( /%20/g, '+' );
        var card = document.getElementById( targetId );

        if ( !card ) {
            if ( callback ) callback( null );
            return;
        }

        // ── Scroll FIRST — instant feedback ──
        _scrollToEl( card );

        // Already expanded → done
        if ( card.classList.contains( 'lawt-art-expanded' ) ) {
            if ( callback ) callback( card );
            return;
        }

        // Expand (AJAX in background), re-scroll after content loads
        expandArticle( card, function() {
            setTimeout( function() {
                _scrollToEl( card );
                if ( callback ) callback( card );
            }, 50 );
        });
    };


    // ── Deep link: handle #arthro-X on page load ─────────────
    (function handleDeepLink() {
        var hash = window.location.hash;
        if ( !hash || hash.indexOf( '#arthro-' ) !== 0 ) return;

        setTimeout( function() {
            var decoded = decodeURIComponent( hash.substring(1).replace( /\+/g, ' ' ) );
            var card = document.getElementById( hash.substring(1) )
                    || document.getElementById( decoded );

            if ( card && card.classList.contains( 'lawt-art-card' ) ) {
                // Scroll first, then expand
                _scrollToEl( card );
                expandArticle( card, function() {
                    setTimeout( function() { _scrollToEl( card ); }, 100 );
                });
            }
        }, 200 );
    })();


    /**
     * Scroll element into view (accounting for sticky bar).
     */
    function _scrollToEl( el ) {
        var bar = document.getElementById( 'lawtContentBar' );
        // Use bar's actual bottom position (accounts for site header + bar height)
        // Add 12px extra padding so article title is clearly visible below toolbar
        var offset = bar ? bar.getBoundingClientRect().bottom + 12 : 80;
        var top = el.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo( { top: top, behavior: 'smooth' } );
    }


    /**
     * Loading toast for jump operations.
     */
    var _jumpToastEl = null;

    function _showJumpToast( message ) {
        _hideJumpToast();

        _jumpToastEl = document.createElement( 'div' );
        _jumpToastEl.className = 'lawt-jump-toast';
        _jumpToastEl.innerHTML = '<span class="lawt-spinner"></span> ' + message;
        document.body.appendChild( _jumpToastEl );

        setTimeout( function() {
            if ( _jumpToastEl ) _jumpToastEl.classList.add( 'visible' );
        }, 10 );
    }

    function _hideJumpToast() {
        if ( _jumpToastEl ) {
            _jumpToastEl.classList.remove( 'visible' );
            var el = _jumpToastEl;
            setTimeout( function() { if ( el.parentNode ) el.remove(); }, 300 );
            _jumpToastEl = null;
        }
    }




    // ── Back to Top ──────────────────────────────────────────
    var backBtn = document.getElementById('lawtBackToTop');
    if (backBtn) {
        window.addEventListener('scroll', function() {
            backBtn.classList.toggle('visible', window.scrollY > 400);
        });
        backBtn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

})();
</script>

<script src="https://cdn.jsdelivr.net/npm/driver.js@1.3.6/dist/driver.js.iife.js"></script>
<script src="https://www.taxheaven.gr/assets/front/lawt/js/lawt-tour.js?v=10"></script>

<script src="https://www.taxheaven.gr/assets/front/lawt/js/lawt-paratimeline.js?v=6"></script>


<script type='text/javascript'>
    window.lazySizesConfig = window.lazySizesConfig || {};
    lazySizesConfig.loadHidden = false;
</script>
<script type="text/javascript" src="https://www.taxheaven.gr/assets/front/my/lazysizes.min.js"></script>

<script>
    $( '.recording_link a' ).on( 'click', function() {
        var id = $( this ).attr( 'id' );

        if( id == 'login-tab' )
        {
            $( '#registerTab' ).removeClass( 'active' );
            $( '#register' ).removeClass( 'active' );
            $( '#loginTab' ).addClass( 'active' );
            $( '#login' ).addClass( 'active' );
        }
        else if( id == 'register-tab' )
        {
            $( '#loginTab' ).removeClass( 'active' );
            $( '#login' ).removeClass( 'active' );
            $( '#registerTab' ).addClass( 'active' );
            $( '#register' ).addClass( 'active' );
        }
    } );
</script>

<script type="text/javascript">
    function expireUCPVideo( videoId, daysToExpire )
    {
        var expires;
        var date = new Date();
        date.setTime(date.getTime() + (daysToExpire * 24 * 60 * 60 * 1000));
        expires = "; expires=" + date.toGMTString();
        document.cookie = 'surpressWebinarUCPVid-' + videoId + '=1' + expires + "; path=/";
    }
</script>



</body>
</html>
