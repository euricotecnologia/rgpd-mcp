legal-acts/icelandic/i32001D0497.pdf"},"content":[{"nodeType":"text","value":"2001/497/EB","marks":[],"data":{}}]},{"nodeType":"text","value":" (pdf) frá 15. júní 2001 um föst samningsákvæði vegna flutnings persónuupplýsinga til þriðju landa, samkvæmt tilskipun nr. 95/46/EB. (pdf)","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Ensk útgáfa: \"Commission Decision ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32001D0497\u0026qid=1705670542277"},"content":[{"nodeType":"text","value":"2001/497/EC","marks":[],"data":{}}]},{"nodeType":"text","value":" (pdf) of 15 June 2001 on standard contractual clauses for the transfer of personal data to third countries, under Directive 95/46/EC.\"","marks":[],"data":{}}]}]}]}]},{"nodeType":"list-item","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Ákvörðun framkvæmdastjórnarinnar ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.efta.int/media/documents/legal-texts/eea/other-legal-documents/translated-acts/icelandic/i32002D0002.pdf"},"content":[{"nodeType":"text","value":"2002/2/EB (pdf)","marks":[],"data":{}}]},{"nodeType":"text","value":" frá 20. desember 2001, í samræmi við tilskipun Evrópuþingsins og ráðsins 95/46/EB, um fullnægjandi vernd persónuupplýsinga sem er tryggð með kanadísku lögunum um vernd persónuupplýsinga og rafræn skjöl (Canadian Information Protection and Electronic Documents Act) (pdf)","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Ensk útgáfa: \"Commission Decision ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32002D0002\u0026qid=1705670595784"},"content":[{"nodeType":"text","value":"2002/2/EC","marks":[],"data":{}}]},{"nodeType":"text","value":" (pdf) of 20 December 2001 pursuant to Directive 95/46/EC of the European Parliament and of the Council on the adequate protection of personal data provided by the Canadian Personal Information Protection and Electronic Documents Act.\"","marks":[],"data":{}}]}]}]}]},{"nodeType":"list-item","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Ákvörðun framkvæmdastjórnarinnar ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.efta.int/sites/default/files/documents/legal-texts/eea/other-legal-documents/solr/translated-legal-acts/icelandic/i32002D0016.pdf"},"content":[{"nodeType":"text","value":"2002/16/EB","marks":[],"data":{}}]},{"nodeType":"text","value":" (pdf) frá 27. desember 2001, um staðlaða samningsskilmála vegna flutnings persónuupplýsinga til vinnsluaðila með staðfestu í þriðju löndum samkvæmt tilskipun 95/46/EB. (pdf)","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Ensk útgáfa: \"Commission Decision ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32002L0016\u0026qid=1705670664031"},"content":[{"nodeType":"text","value":"2002/16/EC","marks":[],"data":{}}]},{"nodeType":"text","value":" (pdf) of 27 December 2001 on standard contractual clauses for the transfer of personal data to processors established in third countries, under Directive 95/46/EC.\"","marks":[],"data":{}}]}]}]}]},{"nodeType":"list-item","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Ákvörðun framkvæmdastjórnarinnar ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.efta.int/media/documents/legal-texts/eea/other-legal-documents/translated-acts/icelandic/i32016D1250.pdf"},"content":[{"nodeType":"text","value":"2016/1250/EB (pdf)","marks":[],"data":{}}]},{"nodeType":"text","value":" frá 12. júlí 2016 sem byggð er á tilskipun Evrópuþingsins og ráðsins 95/46/EB og fjallar um fullnægjandi vernd persónuupplýsinga samkvæmt EU-U.S. Privacy Shield-samkomulaginu um flutning persónuupplýsinga til Bandaríkjanna. ","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Ensk útgáfa: \"Commission Implementing Decision ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"http://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32016D1250\u0026from=EN"},"content":[{"nodeType":"text","value":"(EU) 2016/1250","marks":[],"data":{}}]},{"nodeType":"text","value":" (pdf) of 12 July 2016 pursuant to Directive 95/46/EC of the European Parliament and of the Council on the adequacy of the protection provided by the EU-U.S. Privacy Shield.\"","marks":[],"data":{}}]}]}]}]}]}],"data":{}}},"Html:1M0Uqphf4lyt3LMQ2wz5aZ:answer:2":{"__typename":"Html","id":"1M0Uqphf4lyt3LMQ2wz5aZ:answer:2","document":{"nodeType":"document","content":[{"nodeType":"heading-4","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"text","value":"Alþjóðlegar reglur","marks":[],"data":{"target":{"fields":{"details":{"content":[]}}}}}]}],"data":{}}},"Html:1M0Uqphf4lyt3LMQ2wz5aZ:answer:3":{"__typename":"Html","id":"1M0Uqphf4lyt3LMQ2wz5aZ:answer:3","document":{"nodeType":"document","content":[{"nodeType":"paragraph","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"text","value":"OECD, Efnahags- og framfarastofnunin, gaf frá sér leiðbeinandi reglur til aðildarríkja árið 1980. Bera þær heitið Guidelines on the Protection of Privacy and Transborder Flows of Personal Data. Þessar reglur skuldbinda aðildarríki SÞ ekki að þjóðarrétti en hafa samt sem áður verulega þýðingu fyrir þau ríkjanna sem ekki eru aðilar að samningi Evrópuráðsins frá 1981 eða framfylgja tilskipun Evrópusambandsins og ráðsins nr. 95/46EB. Reglurnar má nálgast á ","marks":[],"data":{"target":{"fields":{"details":{"content":[]}}}}},{"nodeType":"hyperlink","data":{"uri":"https://www.oecd.org/sti/ieconomy/oecdguidelinesontheprotectionofprivacyandtransborderflowsofpersonaldata.htm","target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"text","value":"heimasíðu OECD","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{"target":{"fields":{"details":{"content":[]}}}}},{"nodeType":"hyperlink","data":{"uri":"http://www1.oecd.org/publications/e-book/9302011E.PDF","target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"text","value":".","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{"target":{"fields":{"details":{"content":[]}}}}}]}],"data":{}}},"Html:1M0Uqphf4lyt3LMQ2wz5aZ:answer:4":{"__typename":"Html","id":"1M0Uqphf4lyt3LMQ2wz5aZ:answer:4","document":{"nodeType":"document","content":[{"nodeType":"unordered-list","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"list-item","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"http://www.utanrikisraduneyti.is/samningar/EvrSamningar/nr/554"},"content":[{"nodeType":"text","value":"Samningur Evrópuráðsins um vernd einstaklinga varðandi vélræna vinnslu persónuupplýsinga","marks":[],"data":{}}]},{"nodeType":"text","value":"sem gerður var í Strassborg 28. janúar 1981 (CONVENTION nr. 108 for the Protection of Individuals with regard to Automatic Processing of Personal Data).","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"http://conventions.coe.int/Treaty/EN/Treaties/Html/108.htm"},"content":[{"nodeType":"text","value":"Samningurinn","marks":[],"data":{}}]},{"nodeType":"text","value":" og ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"http://conventions.coe.int/treaty/en/Reports/Html/108.htm"},"content":[{"nodeType":"text","value":"greinargerð","marks":[],"data":{}}]},{"nodeType":"text","value":" með samningnum á ensku","marks":[],"data":{}}]}]}]}]}]}],"data":{}}},"Html:1M0Uqphf4lyt3LMQ2wz5aZ:answer:5":{"__typename":"Html","id":"1M0Uqphf4lyt3LMQ2wz5aZ:answer:5","document":{"nodeType":"document","content":[{"nodeType":"paragraph","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"text","value":"\n","marks":[],"data":{"target":{"fields":{"details":{"content":[]}}}}}]}],"data":{}}},"QuestionAndAnswer:1M0Uqphf4lyt3LMQ2wz5aZ":{"__typename":"QuestionAndAnswer","id":"1M0Uqphf4lyt3LMQ2wz5aZ","question":"Alþjóðasamningar og Evrópulöggjöf","answer":[{"__ref":"Html:1M0Uqphf4lyt3LMQ2wz5aZ:answer:0"},{"__ref":"Html:1M0Uqphf4lyt3LMQ2wz5aZ:answer:1"},{"__ref":"Html:1M0Uqphf4lyt3LMQ2wz5aZ:answer:2"},{"__ref":"Html:1M0Uqphf4lyt3LMQ2wz5aZ:answer:3"},{"__ref":"Html:1M0Uqphf4lyt3LMQ2wz5aZ:answer:4"},{"__ref":"Html:1M0Uqphf4lyt3LMQ2wz5aZ:answer:5"}],"publishDate":""},"FaqList:34ytKHX1oeOr6xkmBSG8Rz":{"__typename":"FaqList","id":"34ytKHX1oeOr6xkmBSG8Rz","title":"Reglur og reglugerðir","showTitle":false,"questions":[{"__ref":"QuestionAndAnswer:52QgW1IgA5kgUGLzmGyAyE"},{"__ref":"QuestionAndAnswer:4oJb9EOhoy0C6ULO4Z5b10"},{"__ref":"QuestionAndAnswer:1vnaBCPckZ4ZsinlJu5KFH"},{"__ref":"QuestionAndAnswer:ZijM9Qz98NwLoGv5CrPdB"},{"__ref":"QuestionAndAnswer:37G7HEb2plFvsBLSEsQcak"},{"__ref":"QuestionAndAnswer:1M0Uqphf4lyt3LMQ2wz5a