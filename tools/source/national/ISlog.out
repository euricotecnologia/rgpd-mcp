ur en samþykkis þess er leitað á vef Stjórnartíðinda","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]}]}],"data":{}}},"QuestionAndAnswer:ZijM9Qz98NwLoGv5CrPdB":{"__typename":"QuestionAndAnswer","id":"ZijM9Qz98NwLoGv5CrPdB","question":"Aðrar reglur og leiðbeiningar","answer":[{"__ref":"Html:ZijM9Qz98NwLoGv5CrPdB:answer:0"}],"publishDate":""},"Html:37G7HEb2plFvsBLSEsQcak:answer:0":{"__typename":"Html","id":"37G7HEb2plFvsBLSEsQcak:answer:0","document":{"nodeType":"document","content":[{"nodeType":"paragraph","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"text","value":"Samkvæmt 15. gr. ","marks":[],"data":{"target":{"fields":{"details":{"content":[]}}}}},{"nodeType":"hyperlink","data":{"uri":"https://island.is/reglugerdir/nr/0606-2023","target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"text","value":"laga um persónuvernd og vinnslu persónuupplýsinga ","marks":[],"data":{}}]},{"nodeType":"text","value":"skal starfræksla fjárhagsupplýsingastofa og vinnsla upplýsinga sem varða fjárhagsmálefni og lánstraust einstaklinga og lögaðila, þar með talin vanskilaskráning og gerð lánshæfismats, í því skyni að miðla þeim til annarra, bundin leyfi Persónuverndar. Í dag er einungis eitt slíkt fyrirtæki starfrækt og það er Creditinfo Lánstraust hf. ","marks":[],"data":{"target":{"fields":{"details":{"content":[]}}}}}]}],"data":{}}},"Html:37G7HEb2plFvsBLSEsQcak:answer:1":{"__typename":"Html","id":"37G7HEb2plFvsBLSEsQcak:answer:1","document":{"nodeType":"document","content":[{"nodeType":"paragraph","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"text","value":"","marks":[],"data":{"target":{"fields":{"details":{"content":[]}}}}},{"nodeType":"asset-hyperlink","data":{"target":{"metadata":{"tags":[{"sys":{"type":"Link","linkType":"Tag","id":"ownerPersonuvernd"}}],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"8k0h54kbe6bj"}},"id":"39wz4ymoyol2Zd