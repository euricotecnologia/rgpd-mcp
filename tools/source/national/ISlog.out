}}]}],"data":{}}},{"__typename":"Html","id":"1M0Uqphf4lyt3LMQ2wz5aZ:answer:4","document":{"nodeType":"document","content":[{"nodeType":"unordered-list","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"list-item","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"http://www.utanrikisraduneyti.is/samningar/EvrSamningar/nr/554"},"content":[{"nodeType":"text","value":"Samningur Evrópuráðsins um vernd einstaklinga varðandi vélræna vinnslu persónuupplýsinga","marks":[],"data":{}}]},{"nodeType":"text","value":"sem gerður var í Strassborg 28. janúar 1981 (CONVENTION nr. 108 for the Protection of Individuals with regard to Automatic Processing of Personal Data).","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"http://conventions.coe.int/Treaty/EN/Treaties/Html/108.htm"},"content":[{"nodeType":"text","value":"Samningurinn","marks":[],"data":{}}]},{"nodeType":"text","value":" og ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"http://conventions.coe.int/treaty/en/Reports/Html/108.htm"},"content":[{"nodeType":"text","value":"greinargerð","marks":[],"data":{}}]},{"nodeType":"text","value":" með samningnum á ensku","marks":[],"data":{}}]}]}]}]}]}],"data":{}}},{"__typename":"Html","id":"1M0Uqphf4lyt3LMQ2wz5aZ:answer:5","document":{"nodeType":"document","content":[{"nodeType":"paragraph","data":{"target":{"fields":{"details":{"content":[]}}}},"content":[{"nodeType":"text","value":"\n","marks":[],"data":{"target":{"fields":{"details":{"content":[]}}}}}]}],"data":{}}}],"publishDate":""}],"id":"34ytKHX1oeOr6xkmBSG8Rz","title":"Reglur og reglugerðir","showTitle":false}],"links":[],"slices"